# Copie para .env.local (ou rode `npm run env:init`, que gera os segredos).
# Nunca versione o .env.local. No Railway, cadastre estas variáveis em Variables
# (`npm run env:secrets` gera os segredos para colar lá).

# PostgreSQL — caracteres especiais na senha devem ser codificados (ex.: @ => %40)
# No Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/sindserm_festa"

# URL pública da aplicação (origem confiável para login e cookies).
# No Railway pode ficar vazia: usa o domínio gerado pelo Railway. Com domínio
# próprio (ex.: https://festa.sindserm.org.br), preencha.
BETTER_AUTH_URL="http://localhost:3000"

# Segredo de sessão do Better Auth (mínimo 32 caracteres)
BETTER_AUTH_SECRET=""

# Chave AES-256 em base64 (32 bytes) que cifra os tokens dos vouchers e os
# documentos (RG e contracheque). Guarde: sem ela, vouchers e documentos não abrem.
DATA_ENCRYPTION_KEY=""

# Token exigido para criar o primeiro administrador em /setup (mínimo 16 caracteres)
SETUP_TOKEN=""

# Opcional: cria o primeiro administrador no deploy e ao ligar o servidor em
# produção, só se o banco ainda não tiver nenhum usuário. Senha com 10 ou mais
# caracteres. Depois do primeiro login, troque a senha em /conta e apague
# ADMIN_PASSWORD.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Fuso horário usado para exibir datas e interpretar o período de inscrições
NEXT_PUBLIC_APP_TIME_ZONE="America/Sao_Paulo"

# Opcional: outros endereços de acesso (ex.: IP da rede local), separados por vírgula
TRUSTED_ORIGINS=""

# Opcional: quantos proxies reversos confiáveis ficam na frente da aplicação
# (usado só para limitar tentativas por IP; padrão 1, que serve para o Railway)
TRUST_PROXY_HOPS="1"
